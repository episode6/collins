#!/usr/bin/make -f
# Modified from the original agent-session-manager
# (https://github.com/r4nd3l/agent-session-manager, GPL-3.0) in the ghackett
# fork. Last modified: 2026-10-30. Full change history: git log for this file.
export PYBUILD_NAME=collins

%:
	dh $@ --with python3 --buildsystem=pybuild

# Two binary packages from the one wheel (debian/control). With PYBUILD_NAME
# set, pybuild installs the wheel into debian/python3-collins -- a staging
# tree here, not a package -- on noble's dh-python and resolute's alike
# (noble's pyproject plugin ignores PYBUILD_DESTDIR, so that tree is the one
# both agree on). debian/collins-service.install and debian/collins.install
# divide it: the Python package and the collins-service and collins-keeper
# commands to collins-service, the collins launcher to collins. dh_missing
# fails the build on a file in it neither claims.
override_dh_install:
	dh_install --sourcedir=debian/python3-collins

override_dh_missing:
	dh_missing --sourcedir=debian/python3-collins --fail-missing

# Both user units are installed and never enabled or started by the package
# (split-service spec §3.10): the window starts the service on demand, and
# the service the keeper.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# The wheel ships the package + the commands. The desktop entry, icons and
# metainfo are not in the wheel's install paths, so install them here, into
# the window's package; the units go into the service's.
execute_after_dh_install:
	install -Dm644 data/collins-service.service \
	  debian/collins-service/usr/lib/systemd/user/collins-service.service
	install -Dm644 data/collins-keeper.service \
	  debian/collins-service/usr/lib/systemd/user/collins-keeper.service
	install -Dm644 data/com.episode6.Collins.metainfo.xml \
	  debian/collins/usr/share/metainfo/com.episode6.Collins.metainfo.xml
	install -Dm644 data/icons/com.episode6.Collins.svg \
	  debian/collins/usr/share/icons/hicolor/scalable/apps/com.episode6.Collins.svg
# The action icons are app-private artwork on generic names, so they go in a
# Collins-owned search-path root, not the shared hicolor theme -- two packages
# cannot both own hicolor/.../tab-close-symbolic.svg, and agent-session-manager
# does. The -panel variants ride along for the tray's IconThemePath.
	install -d debian/collins/usr/share/collins/icons/hicolor/scalable/actions
	install -m644 data/icons/hicolor/scalable/actions/*.svg \
	  debian/collins/usr/share/collins/icons/hicolor/scalable/actions/
	install -m644 data/icons/com.episode6.Collins.svg \
	  data/icons/com.episode6.Collins-panel.svg \
	  data/icons/com.episode6.Collins-panel-working.svg \
	  data/icons/com.episode6.Collins-panel-empty.svg \
	  debian/collins/usr/share/collins/icons/
	install -d debian/collins/usr/share/applications
	sed -e 's|^Exec=.*|Exec=collins|' -e '/^Path=/d' \
	  data/com.episode6.Collins.desktop \
	  > debian/collins/usr/share/applications/com.episode6.Collins.desktop
# Validate what was just installed, mirroring the RPM spec's %check. The
# releases-not-in-order override is the same one the spec carries: the
# metainfo lists the upstream agent-session-manager releases below the fork's
# own, so its versions don't descend end to end -- history, not a mistake.
	desktop-file-validate \
	  debian/collins/usr/share/applications/com.episode6.Collins.desktop
	appstreamcli validate --no-net --override releases-not-in-order=info \
	  debian/collins/usr/share/metainfo/com.episode6.Collins.metainfo.xml
