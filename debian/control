# appstream + desktop-file-utils: debian/rules validates the installed
# metainfo and desktop entry at build time, mirroring the RPM spec's %check.
Build-Depends: appstream,
               debhelper-compat (= 13),
               desktop-file-utils,
               dh-python,
               pybuild-plugin-pyproject,
               python3-all,
               python3-setuptools
Standards-Version: 4.6.2
Homepage: https://github.com/episode6/collins
Rules-Requires-Root: no

Package: collins
Architecture: all
# The two versioned floors are the ones measured against actual API use:
# Gtk.FileDialog and Gtk.FontDialog are GTK 4.10, and Adw.AlertDialog,
# Adw.Dialog, Adw.PreferencesDialog and Adw.AboutDialog are libadwaita 1.5.
# Without them a too-old stack installs cleanly and then dies at import, which
# matters because this package is also the only channel Debian has.
# gtksourceview5 and vte are deliberately unversioned: nothing has
# established what their real minimum is, and a guessed floor locks out
# users who would have been fine. libspelling is only Recommends: the
# composer degrades to an unchecked text box without it. So is GStreamer
# (the core typelib and the base plugins, which carry playbin): it plays the
# notification sound, and without it the display's beep does.
Depends: ${python3:Depends},
         ${misc:Depends},
         python3-gi,
         gir1.2-gtk-4.0 (>= 4.10),
         gir1.2-adw-1 (>= 1.5),
         gir1.2-vte-3.91,
         gir1.2-gtksource-5
Recommends: gir1.2-spelling-1,
            gir1.2-gstreamer-1.0,
            gir1.2-gst-plugins-base-1.0
Description: native GTK4 desktop app to manage Claude Code sessions
 Collins browses every Claude Code session on your machine in a
 sidebar grouped by project, lets you name and star them, and resumes any of
 them in embedded terminal tabs.
 .
 It is an unofficial community tool, not affiliated with Anthropic, and never
 modifies the agents' own session data.
