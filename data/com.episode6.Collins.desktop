[Desktop Entry]
Type=Application
Name=Collins
GenericName=Session Manager
Comment=Manage and resume your AI coding agent sessions
Exec=python3 -m collins
Path=/opt/collins
Icon=com.episode6.Collins
Terminal=false
Categories=Development;
Keywords=claude;ai;agent;terminal;session;code;
StartupNotify=true
StartupWMClass=com.episode6.Collins
