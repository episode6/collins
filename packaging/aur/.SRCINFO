pkgbase = collins
	pkgdesc = Native GTK4 desktop app to manage and resume Claude Code sessions
	pkgver = 0.1.4
	pkgrel = 1
	url = https://github.com/episode6/collins
	arch = any
	license = GPL-3.0-or-later
	license = CC0-1.0
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-wheel
	makedepends = python-setuptools
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libadwaita
	depends = vte4
	depends = gtksourceview5
	depends = libsoup3
	depends = python-markdown-it-py
	depends = python-linkify-it-py
	optdepends = claude-code: resume Claude Code sessions
	optdepends = libspelling: spell-check in the prompt composer
	optdepends = gstreamer: the notification sound (the beep stands in without it)
	optdepends = gst-plugins-base-libs: playbin, which plays it
	optdepends = bubblewrap: run sessions inside a filesystem sandbox
	optdepends = bindfs: allowed directories reach a running sandboxed session
	optdepends = fuse3: allowed directories reach a running sandboxed session
	source = collins-0.1.4.tar.gz::https://github.com/episode6/collins/archive/refs/tags/v0.1.4.tar.gz
	sha256sums = SKIP

pkgname = collins
