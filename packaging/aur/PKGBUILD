# Contributor: Máté Molnár <molnar.mate@zengo.eu> (original agent-session-manager)

# A split package (split-service spec §3.24, PR-3.7), the same split as the
# .deb and the RPM: collins-service is the headless half (the whole Python
# package -- one tree, so the window's modules ride along as files the
# service never imports -- the collins-service and collins-keeper commands
# and both systemd user units, never enabled), installable on its own on a
# box with no display; collins is the window (its launcher, desktop entry,
# icons and metainfo, and the GTK stack) and depends on the collins-service
# of the same build, since the window's modules are in it.
pkgbase=collins
pkgname=('collins' 'collins-service')
pkgver=0.1.4
pkgrel=1
pkgdesc="Native GTK4 desktop app to manage and resume Claude Code sessions"
arch=('any')
url="https://github.com/episode6/collins"
license=('GPL-3.0-or-later' 'CC0-1.0' 'MIT')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
# Refresh the sha256 when a v$pkgver tag exists (see packaging/aur/README.md).
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgbase-$pkgver"
  python -m build --wheel --no-isolation
  # Both packages are cut from one install of the wheel, staged here; each
  # package_*() takes its half of it.
  rm -rf "$srcdir/stage"
  python -m installer --destdir="$srcdir/stage" dist/*.whl
}

package_collins-service() {
  pkgdesc="Headless session service for Collins (collins-service and collins-keeper)"
  # What the service and the keeper import: GLib, GObject and Gio
  # (python-gobject brings glib2 and its typelibs) and libsoup 3; no
  # markdown library. The sandbox tools run on the service's side.
  depends=('python' 'python-gobject' 'libsoup3')
  optdepends=('claude-code: the CLI every session runs'
              'bubblewrap: run sessions inside a filesystem sandbox'
              'bindfs: allowed directories reach a running sandboxed session'
              'fuse3: allowed directories reach a running sandboxed session')

  cd "$pkgbase-$pkgver"
  install -d "$pkgdir/usr/lib" "$pkgdir/usr/bin"
  cp -a "$srcdir"/stage/usr/lib/python3* "$pkgdir/usr/lib/"
  install -m755 "$srcdir/stage/usr/bin/collins-service" \
    "$srcdir/stage/usr/bin/collins-keeper" "$pkgdir/usr/bin/"
  # Both systemd user units, never enabled: the window starts the service
  # on demand, the service the keeper.
  install -Dm644 data/collins-service.service \
    "$pkgdir/usr/lib/systemd/user/collins-service.service"
  install -Dm644 data/collins-keeper.service \
    "$pkgdir/usr/lib/systemd/user/collins-keeper.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_collins() {
  depends=("collins-service=$pkgver-$pkgrel" 'python' 'python-gobject' 'gtk4'
           'libadwaita' 'vte4' 'gtksourceview5' 'libsoup3' 'python-markdown-it-py'
           'python-linkify-it-py')
  optdepends=('claude-code: resume Claude Code sessions'
              'libspelling: spell-check in the prompt composer'
              'gstreamer: the notification sound (the beep stands in without it)'
              'gst-plugins-base-libs: playbin, which plays it')

  cd "$pkgbase-$pkgver"
  install -Dm755 "$srcdir/stage/usr/bin/collins" "$pkgdir/usr/bin/collins"

  local appid=com.episode6.Collins
  # Desktop entry: launch the installed command, drop the dev working dir.
  sed -e "s|^Exec=.*|Exec=collins|" -e "/^Path=/d" \
    "data/$appid.desktop" | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/applications/$appid.desktop"

  install -Dm644 "data/icons/$appid.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$appid.svg"
  # The action icons need no install step: they ride inside the wheel's
  # package (collins-service's half). They must not go in the shared
  # hicolor theme anyway -- app-private artwork on generic names
  # (tab-close-symbolic, archive-symbolic, ...) put there outranks the
  # system's own for every application on the machine.
  install -Dm644 "data/$appid.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$appid.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
